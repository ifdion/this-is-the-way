{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "this-is-the-way",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "titw.ddo.my.id",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
